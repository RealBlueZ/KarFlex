<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KarFlex">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".pages.LoginActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".pages.SignUpActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="true" />
        <activity
            android:name=".pages.HomeActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="true" />
        <activity
            android:name=".pages.VerifyActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="true" />
        <activity
            android:name=".pages.MyRentalsActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="true" />
        <activity
            android:name=".pages.ProfileActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".pages.RentalHistoryActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".pages.DetailVehicleActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".pages.LocationActivity"
            android:theme="@style/Base.Theme.KarFlex.FullScreen"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <service android:name=".services.JSONService"
            android:exported="false"/>
    </application>

</manifest>